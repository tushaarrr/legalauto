# Copy to backend/.env and fill in. NEVER commit the real .env.

# --- LLM (required) ----------------------------------------------------------
# Your OpenAI API key. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: override the model. Defaults to gpt-4o-mini (cheap, supports strict
# Structured Outputs). For higher classification accuracy on the Phase 4 sweep,
# try gpt-4o.
# LLM_MODEL=gpt-4o-mini

# --- Enrichment sources ------------------------------------------------------
# Every source below is OPTIONAL. A source with no key self-reports
# "unavailable" and the pipeline continues with whatever the others returned —
# a missing key is never a crash.

# CourtListener (Free Law Project). Search works WITHOUT a token; setting one
# raises the rate limit. Free token: https://www.courtlistener.com/help/api/
# COURTLISTENER_TOKEN=

# GLEIF (Global LEI index) needs NO key and no configuration — it is the entity
# verification source and works out of the box. Listed here only so you know it
# is in use. It replaced OpenCorporates, whose API now requires an approved key.

# Firecrawl, for public listings with no clean API. BOTH vars are required
# before any scrape happens, and the target's robots.txt is checked first; if it
# disallows (or cannot be read), the source skips and flags rather than scraping.
# There is deliberately no default target. Use {query} for the party name.
# FIRECRAWL_API_KEY=fc-...
#
# Pick a target whose robots.txt actually permits it. Most legal-data sites do
# NOT: CanLII, SEC EDGAR, CourtListener and Justia all disallow crawlers, and
# this client skips and flags rather than scraping them anyway. Verified as
# permitted on 2026-07-19:
#   https://find-and-update.company-information.service.gov.uk/search?q={query}
#   https://bizfileonline.sos.ca.gov/search/business
# FIRECRAWL_TARGET_URL=https://find-and-update.company-information.service.gov.uk/search?q={query}

# --- Storage / CRM -----------------------------------------------------------
# Which CRM backend /approve writes to:
#   auto (default) -> Airtable if its vars below are set, otherwise the local CSV
#   csv            -> always the local CSV (zero config; the demo works as-is)
#   airtable       -> always Airtable (requires the three vars below)
# STORAGE_BACKEND=auto

# CSV backend: where the local "CRM" spreadsheet lives. Defaults to
# backend/data/crm.csv. Relative paths are resolved against backend/.
# CRM_CSV_PATH=data/crm.csv

# Airtable backend (preferred CRM). All three are required to use it. The table
# should have columns matching the record fields (intake_id, client_name, ...);
# writes use typecast so text columns accept the values.
# AIRTABLE_API_KEY=pat...
# AIRTABLE_BASE_ID=app...
# AIRTABLE_TABLE_NAME=Intakes
